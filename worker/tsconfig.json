{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": {
      "shared": ["./shared/index.ts"],
      "shared/*": ["./shared/*"]
    }
  },
  "include": ["**/*.ts", "../shared/**/*.ts"]
}
