{
  "name": "birthday-hunt",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:test": "vitest run",
    "worker:test:watch": "vitest",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run worker:test && npm run build && npm run e2e",
    "db:migrate": "wrangler d1 migrations apply DB --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.toml",
    "db:exec": "wrangler d1 execute DB --local --config worker/wrangler.toml",
    "icons:gen": "node scripts/generate-icons.mjs",
    "cap:assets:gen": "node scripts/generate-native-assets.mjs",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor #1F1430 --iconBackgroundColorDark #1F1430 --splashBackgroundColor #1F1430 --splashBackgroundColorDark #1F1430",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npm run build && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "canvas-confetti": "^1.9.3",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20260526.1",
    "@playwright/test": "^1.60.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.95.0"
  }
}
